node_modules/
dist/
dist-ssr/
*.local
.DS_Store
.vite/

# テスト成果物
/test-results/
/playwright-report/
/playwright/.cache/

# 撮影した PNG は npm run shot で再生成できる。記録は index.json だけ残す
/capture/pose/*.png

# 参照画像の切り出しは npm run ref-split で再生成できる。
# 記録として残すのは一覧（contact-*.png）と split-report.json だけ
/reference/animals/*/

# 採点の重なり画像は npm run match-score で再生成できる
/capture/m1-*.png

# アプリの画面写真は確認用。実機で撮り直すもの
/capture/app-*.png
